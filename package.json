{
  "name": "pixelin",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:web dev:api",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace services/api run dev"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "three": "^0.184.0",
    "vanta": "^0.5.24"
  }
}
